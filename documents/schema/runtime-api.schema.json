{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurorascript.dev/schema/runtime-api.schema.json",
  "title": "AuroraScript Runtime API Schema",
  "type": "object",
  "required": ["language", "versionTarget", "modules", "globals", "prototypes"],
  "properties": {
    "$schema": { "type": "string" },
    "language": { "const": "AuroraScript" },
    "versionTarget": { "type": "string" },
    "modules": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/module" }
    },
    "globals": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/typeOrObject" }
    },
    "prototypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/member" }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "module": {
      "type": "object",
      "required": ["kind", "modulePath", "members"],
      "properties": {
        "kind": { "const": "module" },
        "modulePath": { "type": "string", "minLength": 1 },
        "members": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/member" }
        },
        "notes": { "$ref": "#/$defs/localizedNotes" }
      },
      "additionalProperties": false
    },
    "typeOrObject": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["constructor", "type", "object", "function", "constant"] },
        "callable": { "type": "boolean" },
        "constructors": {
          "type": "array",
          "items": { "$ref": "#/$defs/constructor" }
        },
        "members": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/member" }
        },
        "notes": { "$ref": "#/$defs/localizedNotes" }
      },
      "additionalProperties": false
    },
    "constructor": {
      "type": "object",
      "required": ["parameters", "returns"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "returns": { "type": "string" },
        "notes": { "$ref": "#/$defs/localizedNotes" }
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["method", "property", "constant"] },
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "returns": { "type": "string" },
        "overloads": {
          "type": "array",
          "items": { "type": "string" }
        },
        "writable": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/localizedNotes" }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "optional": { "type": "boolean" },
        "variadic": { "type": "boolean" },
        "default": { "type": ["boolean", "number", "string", "null"] }
      },
      "additionalProperties": false
    },
    "localizedNotes": {
      "oneOf": [
        {
          "type": "array",
          "items": { "type": "string" }
        },
        {
          "type": "object",
          "properties": {
            "en": {
              "type": "array",
              "items": { "type": "string" }
            },
            "zh-CN": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      ]
    }
  }
}

