{
  "name": "aurorascript-vscode",
  "displayName": "AuroraScript",
  "description": "Language support for AuroraScript",
  "version": "1.0.0",
  "icon": "images/icon.png",
  "repository": "https://github.com/l2060/AuroraScript",
  "publisher": "l2060",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:AuroraScript",
    "onDebug"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "AuroraScript",
        "aliases": [
          "AuroraScript",
          "as"
        ],
        "extensions": [
          ".as"
        ],
        "icon": {
          "light": "images/icon.png",
          "dark": "images/icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "AuroraScript",
        "scopeName": "source.AuroraScript",
        "path": "./syntaxes/AuroraScript.tmLanguage.json"
      }
    ],
    "debuggers": [
      {
        "type": "AuroraScript",
        "label": "AuroraScript Debug",
        "configurationAttributes": {
          "attach": {
            "properties": {
              "host": {
                "type": "string",
                "description": "Host to connect to",
                "default": "localhost"
              },
              "port": {
                "type": "number",
                "description": "Port to connect to",
                "default": 4711
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "AuroraScript",
            "request": "attach",
            "name": "Attach to AuroraScript",
            "host": "localhost",
            "port": 4711
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "AuroraScript"
      }
    ]
  },
  "scripts": {
    "package": "tsc -p ./ && vsce package --no-yarn --no-dependencies",
    "build": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.0"
  }
}