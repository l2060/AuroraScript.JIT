{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "AuroraScript",
    "scopeName": "source.AuroraScript",
    "fileTypes": [
        "as"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#imports"
        },
        {
            "include": "#object-access"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#functions"
        }
    ],
    "repository": {
        "imports": {
            "patterns": [
                {
                    "match": "\\b(import)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(from)",
                    "captures": {
                        "1": {
                            "name": "keyword.other.auroraScript"
                        },
                        "2": {
                            "name": "entity.name.type.module.auroraScript"
                        },
                        "3": {
                            "name": "keyword.other.auroraScript"
                        }
                    }
                }
            ]
        },
        "object-access": {
            "patterns": [
                {
                    "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.auroraScript"
                        },
                        "2": {
                            "name": "entity.name.function.auroraScript"
                        }
                    }
                },
                {
                    "match": "(\\.)([a-zA-Z_][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.auroraScript"
                        },
                        "2": {
                            "name": "variable.other.property.auroraScript"
                        }
                    }
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.auroraScript",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.auroraScript",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.auroraScript",
                    "match": "\\b(if|else|for|while|break|continue|return|debugger|in)\\b"
                },
                {
                    "name": "keyword.other.auroraScript",
                    "match": "\\b(var|const|function|func|new|delete|typeof|as|declare|enum|export|import|include|from)\\b"
                },
                {
                    "name": "constant.language.auroraScript",
                    "match": "\\b(true|false|null)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.auroraScript",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.auroraScript",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.auroraScript",
                    "begin": "'",
                    "end": "'",
                    "patterns": [
                        {
                            "name": "constant.character.escape.auroraScript",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.other.auroraScript",
                    "match": "(\\|>).*$",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.string.begin.auroraScript"
                        }
                    }
                },
                {
                    "include": "#string-template"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.auroraScript",
                    "match": "\\b0x[0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.auroraScript",
                    "match": "\\b\\d+(\\.\\d+)?\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.auroraScript",
                    "match": "\\+|\\-|\\*|\\/|%"
                },
                {
                    "name": "keyword.operator.comparison.auroraScript",
                    "match": "==|!=|<|>|<=|>="
                },
                {
                    "name": "keyword.operator.logical.auroraScript",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.assignment.auroraScript",
                    "match": "=|\\+=|\\-=|\\*=|\\/=|%="
                },
                {
                    "name": "keyword.operator.bitwise.auroraScript",
                    "match": "&|\\||\\^|~|<<|>>|>>>"
                },
                {
                    "name": "keyword.operator.other.auroraScript",
                    "match": "\\.\\.\\.|=>|\\?|:"
                }
            ]
        },
        "variables": {
            "patterns": [
                {
                    "name": "entity.name.type.module.auroraScript",
                    "match": "\\b(global|Number|Array|String|Boolean|Object|Date|Proxy|Regex|StringBuffer|JSON|Math|HotPatch|HashMap|console)\\b|(\\$state|\\$args)\\b"
                },
                {
                    "name": "variable.other.auroraScript",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.auroraScript",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                }
            ]
        },
        "string-template": {
            "patterns": [
                {
                    "name": "string.quoted.template.auroraScript",
                    "begin": "`",
                    "end": "`",
                    "patterns": [
                        {
                            "name": "constant.character.escape.auroraScript",
                            "match": "\\\\."
                        },
                        {
                            "include": "#template-expression"
                        }
                    ]
                }
            ]
        },
        "template-expression": {
            "patterns": [
                {
                    "begin": "\\$\\{",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.template-expression.begin.auroraScript"
                        }
                    },
                    "end": "\\}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.template-expression.end.auroraScript"
                        }
                    },
                    "patterns": [
                        {
                            "include": "$self"
                        }
                    ]
                }
            ]
        }
    }
}