<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>aurora-mcp</ToolCommandName>
		<PackageId>AuroraScript.Mcp</PackageId>
		<Version>3.0.0</Version>
		<Title>AuroraScript MCP Server</Title>
		<Description>MCP server for AuroraScript language docs, schema, examples, and script validation.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>aurora;aurorascript;mcp;llm;script</PackageTags>
		<RepositoryUrl>https://github.com/l2060/AuroraScript.JIT.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<ToolPackageRuntimeIdentifiers>win-x64;linux-x64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
		<RuntimeIdentifiers>$(ToolPackageRuntimeIdentifiers)</RuntimeIdentifiers>
		<PublishSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</PublishSelfContained>
		<SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
		<PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
		<PublishTrimmed>false</PublishTrimmed>
		<EnableCompressionInSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</EnableCompressionInSingleFile>
		<AllowedReferenceRelatedFileExtensions></AllowedReferenceRelatedFileExtensions>
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
		<PublishDocumentationFiles>false</PublishDocumentationFiles>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/l2060/AuroraScript.JIT</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\AuroraScript.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\icon.png">
			<Pack>True</Pack>
			<Visible>false</Visible>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="..\..\documents\**\*.*">
			<Visible>false</Visible>
			<LogicalName>AuroraScript.Mcp.Documents/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<Target Name="RemoveSymbolsAndDocsFromToolPublish" AfterTargets="ComputeFilesToPublish">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.xml'" />
		</ItemGroup>
	</Target>

	<Target Name="PackToolAfterReleaseBuild" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'&#xA;            and '$(RuntimeIdentifier)' == ''&#xA;            and '$(_IsPacking)' != 'true'&#xA;            and '$(AuroraSkipPackToolAfterBuild)' != 'true'">
		<MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Pack" Properties="Configuration=$(Configuration);GeneratePackageOnBuild=false;AuroraSkipPackToolAfterBuild=true" />
	</Target>

</Project>
