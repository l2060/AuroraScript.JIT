<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuroraScript.LanguageServices\AuroraScript.LanguageServices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\documents\schema\runtime-api.json"
                      LogicalName="AuroraScript.LanguageServer.Resources.runtime-api.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuroraScript.LanguageServer.Tests" />
  </ItemGroup>

</Project>
