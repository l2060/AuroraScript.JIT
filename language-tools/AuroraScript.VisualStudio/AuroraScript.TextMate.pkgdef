[$RootKey$\TextMate\Repositories]
"AuroraScript"="$PackageFolder$\Grammars"

[$RootKey$\TextMate\LanguageMapping]
".as"="source.aurora"
".tdoc"="source.aurora"

[$RootKey$\TextMate\LanguageConfiguration\GrammarMapping]
"source.aurora"="$PackageFolder$\language-configuration.json"

[$RootKey$\TextMate\LanguageConfiguration\ContentTypeMapping]
"aurorascript"="$PackageFolder$\language-configuration.json"

[$RootKey$\TextMate\ContentTypeMapping]
"aurorascript"="source.aurora"
