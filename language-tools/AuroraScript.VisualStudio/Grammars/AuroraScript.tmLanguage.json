          "captures": {
            "1": { "name": "keyword.control.export.aurora" },
            "2": { "name": "keyword.declaration.variable.aurora" },
            "3": { "name": "variable.other.aurora" }
          }
        },
        {
          "name": "meta.declaration.context.aurora",
          "match": "\\b(context)\\s+([\\p{L}_$][\\p{L}\\p{N}_$]*)(?:\\s+(as)\\s+([\\p{L}_$][\\p{L}\\p{N}_$]*))?",
          "captures": {
