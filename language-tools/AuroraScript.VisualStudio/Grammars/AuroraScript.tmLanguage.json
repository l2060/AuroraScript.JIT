            }
          ]
        },
        {
          "name": "string.quoted.single.aurora",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.aurora" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.aurora" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aurora",
              "match": "\\\\[abfnrtv0\\\\'\"`$\\{\\}]"
            },
            {
              "name": "invalid.illegal.escape.aurora",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "meta.string.template.aurora",
          "begin": "`",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.aurora" }
          },
          "end": "`",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.aurora" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.aurora",
              "match": "\\\\[abfnrtv0\\\\'\"`$\\{\\}]"
            },
            {
              "name": "invalid.illegal.escape.aurora",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.expression.aurora",
              "begin": "\\$\\{",
              "beginCaptures": {
                "0": { "name": "punctuation.section.embedded.begin.aurora" }
              },
              "end": "\\}",
              "endCaptures": {
                "0": { "name": "punctuation.section.embedded.end.aurora" }
              },
              "patterns": [
                { "include": "#expression" }
              ]
            },
            {
              "name": "string.interpolated.aurora",
              "match": "[^`\\\\$]+|\\$(?!\\{)"
            }
          ]
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.aurora",
          "match": "\\b(?:Any|Array|Boolean|BooleanArray|Date|Error|Float32Array|Float64Array|Function|HashMap|Int16Array|Int32Array|Int64Array|Int8Array|Null|Number|Object|Proxy|Regex|String|StringBuffer|UInt16Array|UInt32Array|UInt64Array|UInt8Array|int32|void|Void)\\b"
