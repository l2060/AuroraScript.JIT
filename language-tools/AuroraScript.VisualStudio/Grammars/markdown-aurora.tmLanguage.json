{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AuroraScript Markdown Codeblock",
  "scopeName": "markdown.aurora.codeblock",
  "injectionSelector": "L:text.html.markdown, L:text.markdown, L:markup.fenced_code.block.markdown",
  "patterns": [
    {
      "include": "#fenced-aurora"
    }
  ],
  "repository": {
    "fenced-aurora": {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(aurora(?:script)?)((\\s+|:|:\\s+)[^`~]*)?$)",
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" }
      },
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.aurora",
          "patterns": [
            { "include": "source.aurora" }
          ]
        }
      ]
    }
  }
}
