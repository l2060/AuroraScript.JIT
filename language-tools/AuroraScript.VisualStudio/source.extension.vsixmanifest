<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="AuroraScript.VisualStudio" Version="0.1.32" Language="en-US" Publisher="AuroraScript" />
    <DisplayName>AuroraScript for Visual Studio</DisplayName>
    <Description xml:space="preserve">AuroraScript language support for Visual Studio: syntax coloring, IntelliSense, diagnostics, definition, references, rename, and built-in API declaration navigation.</Description>
    <License>Assets\LICENSE.txt</License>
    <Icon>Assets\icon.png</Icon>
    <Tags>AuroraScript;language server;LSP;IntelliSense</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName=".NET Framework" Version="[4.7.2,)" />
  </Dependencies>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="File" Path="AuroraScript.VisualStudio.dll" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="AuroraScript.TextMate.pkgdef" />
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="File" Path="Debugger\AuroraScript.Debugger.pkgdef" />
    <Asset Type="DebuggerEngineExtension" d:Source="File" Path="AuroraScript.VisualStudio.vsdconfig" />
  </Assets>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
</PackageManifest>
