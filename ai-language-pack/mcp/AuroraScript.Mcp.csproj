<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>aurora-mcp</ToolCommandName>
    <PackageId>AuroraScript.Mcp</PackageId>
    <Version>2.1.1</Version>
    <Title>AuroraScript MCP Server</Title>
    <Description>MCP server for AuroraScript language docs, schema, examples, and script validation.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>aurora;aurorascript;mcp;llm;script</PackageTags>
    <RepositoryUrl>https://github.com/l2060/AuroraScript.JIT.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AuroraScript.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\**\*.*" Exclude="..\mcp\bin\**;..\mcp\obj\**;..\mcp\*.csproj;..\mcp\*.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ai-language-pack\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
</Project>
